// Progress Copilot — Prisma schema (Phase 1)
// All user-owned data is tenant-isolated via userId.
// Timestamps are stored as timestamptz (DateTime in Prisma maps to it on Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TargetStatus {
  INCOMPLETE
  COMPLETED
}

enum Sender {
  USER
  AI
}

// ─────────────────────────────────────────────────────────────────────────────
// User (tenant root)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  fullName             String
  email                String    @unique
  password             String // bcrypt hash
  avatar               String?
  whatsapp             String?
  gender               String?
  maritalStatus        String?
  address              String?
  country              String?
  role                 String?
  experience           String?
  education            String?
  // ── Personalization (Edith context) ──────────────────────────────────────
  hometown             String?
  university           String?
  degree               String?
  yearSemester         String?
  hobbies              String? // free-text, comma-separated
  interests            String? // free-text, comma-separated
  aiBio                String? // anything else the user wants Edith to remember
  // ─────────────────────────────────────────────────────────────────────────
  points               Int       @default(0)
  dailyStreak          Int       @default(0)
  lastTaskCompleteDate DateTime?
  theme                String    @default("light") // "light" | "dark"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  futureGoal FutureGoal?
  targets    Target[]
  tasks      Task[]
  notes      Note[]
  courses    Course[]
  reminders  Reminder[]
  chats      ChatHistory[]

  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Future Goal (singleton per user — Life Path endpoint of the timeline)
// ─────────────────────────────────────────────────────────────────────────────

model FutureGoal {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Target (with sub-tasks as Task rows where targetId is set)
// ─────────────────────────────────────────────────────────────────────────────

model Target {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  deadline    DateTime?
  priority    Priority     @default(MEDIUM)
  status      TargetStatus @default(INCOMPLETE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task (standalone OR target sub-task via targetId)
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  targetId    String?
  title       String
  description String?
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  priority    Priority  @default(MEDIUM) // inherited from target if targetId set
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Target?    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, isCompleted])
  @@index([userId, createdAt])
  @@index([userId, completedAt])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Note
// ─────────────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Course
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id           String   @id @default(cuid())
  userId       String
  semester     String?
  title        String
  resourceLink String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reminder (polymorphic-ish: targetId OR taskId)
// ─────────────────────────────────────────────────────────────────────────────

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  targetId  String?
  taskId    String?
  time      DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, time])
  @@index([userId, isSent])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Assistant chat
// ─────────────────────────────────────────────────────────────────────────────

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  sender    Sender
  content   String
  createdAt DateTime @default(now())

  chat ChatHistory @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}
